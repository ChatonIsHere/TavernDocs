# Copy to .env and fill in. Only DISCORD_TOKEN is required.

# From the Discord Developer Portal, Bot tab. Never commit it.
DISCORD_TOKEN=

# Register commands in one server only, so changes show up straight away. Leave empty for global commands.
DEV_GUILD_ID=

# Where the site publishes the bot index (the folder with manifest.json).
# For a local site build: run "npm run serve" in the site folder and use http://localhost:3000/bot
INDEX_URL=https://townshiptale.dev/bot

# TavernMods' index, for /mod. Empty turns /mod off.
TAVERNMODS_URL=https://raw.githubusercontent.com/ModdingTavern/TavernMods/main/repository.json
TAVERNMODS_PAGE=https://moddingtavern.github.io/TavernMods/#mods

# Seconds between public replies from one user.
COOLDOWN_SECONDS=5

# Where the gap counts are saved.
DATA_DIR=./data

# Port for GET /health. 0 turns it off.
HEALTH_PORT=0

# fatal, error, warn, log, debug or verbose. Empty: log and above.
LOG_LEVEL=
