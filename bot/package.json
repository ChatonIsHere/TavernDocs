{
    "name": "taverndocs-bot",
    "version": "0.1.0",
    "private": true,
    "license": "UNLICENSED",
    "description": "TavernDocs Discord bot: guides, types and reference lookups from the TavernDocs site",
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "start": "node dist/main.js",
        "dev": "tsc -p tsconfig.build.json && node dist/main.js",
        "test": "tsc -p tsconfig.json && node --test \"dist-test/**/*.spec.js\"",
        "bench": "tsc -p tsconfig.json && node dist-test/search/bench.js"
    },
    "dependencies": {
        "@huggingface/transformers": "^4.3.2",
        "@nestjs/common": "^11.0.0",
        "@nestjs/config": "^4.0.0",
        "@nestjs/core": "^11.0.0",
        "discord.js": "^14.16.3",
        "joi": "^17.13.3",
        "necord": "^6.12.4",
        "reflect-metadata": "^0.2.1",
        "rxjs": "^7.8.1"
    },
    "devDependencies": {
        "@types/node": "^24.0.0",
        "typescript": "^5.6.3"
    }
}
